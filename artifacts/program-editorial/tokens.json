{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Program Editorial with a cool blue-gray action palette and user-selected neutral-lavender light surfaces. Typography, spacing and radius retain the editorial system; semantic color roles are contrast-checked adaptations. Edit this file, never generated theme outputs.",
  "color": {
    "$type": "color",
    "light": {
      "primary": { "$value": "#3f6f8f", "$description": "Cool blue-gray for primary actions and links." },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e8eef3" },
      "secondaryForeground": { "$value": "#1f3445" },
      "accent": { "$value": "#506f85", "$description": "Restrained blue accent with readable contrast on light surfaces." },
      "accentForeground": { "$value": "#ffffff" },
      "background": { "$value": "#F8F7FA" },
      "foreground": { "$value": "#1f3445" },
      "border": { "$value": "#E8E2ED" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#1f3445" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1f3445" },
      "muted": { "$value": "#e8eef3" },
      "mutedForeground": { "$value": "#526777" },
      "destructive": { "$value": "#b43c29" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#718494" },
      "ring": { "$value": "#3f6f8f" },
      "chart1": { "$value": "#3f6f8f" },
      "chart2": { "$value": "#557f98" },
      "chart3": { "$value": "#71899a" },
      "chart4": { "$value": "#8b7c68" },
      "chart5": { "$value": "#6e708f" },
      "sidebar": { "$value": "#1f3445" },
      "sidebarForeground": { "$value": "#ffffff" },
      "sidebarBorder": { "$value": "#435460" },
      "sidebarPrimary": { "$value": "#c5dce9" },
      "sidebarPrimaryForeground": { "$value": "#1f3445" },
      "sidebarAccent": { "$value": "#2d4453" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#c5dce9" }
    },
    "dark": {
      "primary": { "$value": "#8eb8cf" },
      "primaryForeground": { "$value": "#10202c" },
      "secondary": { "$value": "#2d4453" },
      "secondaryForeground": { "$value": "#eaf1f5" },
      "accent": { "$value": "#a0bfd0" },
      "accentForeground": { "$value": "#10202c" },
      "background": { "$value": "#111d28" },
      "foreground": { "$value": "#eaf1f5" },
      "border": { "$value": "#435460" },
      "card": { "$value": "#1b2b37" },
      "cardForeground": { "$value": "#eaf1f5" },
      "popover": { "$value": "#1b2b37" },
      "popoverForeground": { "$value": "#eaf1f5" },
      "muted": { "$value": "#293b48" },
      "mutedForeground": { "$value": "#bec9d0" },
      "destructive": { "$value": "#ef9b89" },
      "destructiveForeground": { "$value": "#10202c" },
      "input": { "$value": "#91a2ad" },
      "ring": { "$value": "#8eb8cf" },
      "chart1": { "$value": "#8eb8cf" },
      "chart2": { "$value": "#a0bfd0" },
      "chart3": { "$value": "#83a3b7" },
      "chart4": { "$value": "#b2a690" },
      "chart5": { "$value": "#a5a2c2" },
      "sidebar": { "$value": "#172632" },
      "sidebarForeground": { "$value": "#eaf1f5" },
      "sidebarBorder": { "$value": "#435460" },
      "sidebarPrimary": { "$value": "#8eb8cf" },
      "sidebarPrimaryForeground": { "$value": "#10202c" },
      "sidebarAccent": { "$value": "#2d4453" },
      "sidebarAccentForeground": { "$value": "#eaf1f5" },
      "sidebarRing": { "$value": "#8eb8cf" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "Noto Sans Arabic", "sans-serif"],
        "$description": "DM Sans for Latin UI/body text; Noto Sans Arabic for Arabic glyphs."
      },
      "serif": {
        "$value": ["DM Sans", "Noto Sans Arabic", "sans-serif"],
        "$description": "Legacy display-slot alias; proportional text uses the shared sans-serif stack."
      },
      "mono": { "$value": ["IBM Plex Mono", "Noto Sans Arabic", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.1875rem",
      "$description": "Source 3px action corner. Alternate action corners multiply this by 14/3; pill controls use the capsule shape."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
