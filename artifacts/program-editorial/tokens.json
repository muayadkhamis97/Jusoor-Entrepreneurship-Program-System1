{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Program Editorial. Light foundations extracted from the selected landing mockup. Dark mode and unrepresented semantic/chart/sidebar roles are derived extensions, not source modes. Edit this file, never generated theme outputs.",
  "color": {
    "$type": "color",
    "light": {
      "primary": { "$value": "#245c70", "$description": "Source teal: primary actions and text actions." },
      "primaryForeground": { "$value": "#fff5e9" },
      "secondary": { "$value": "#eddfd1", "$description": "Source paper2: supporting paper surface." },
      "secondaryForeground": { "$value": "#192f40" },
      "accent": { "$value": "#c74935", "$description": "Source terracotta: editorial emphasis, not default actions." },
      "accentForeground": { "$value": "#ffffff", "$description": "Derived foreground for AA contrast on the source accent." },
      "background": { "$value": "#f7eee4" },
      "foreground": { "$value": "#192f40" },
      "border": { "$value": "#d8c8b8" },
      "card": { "$value": "#fff8f0" },
      "cardForeground": { "$value": "#192f40" },
      "popover": { "$value": "#fff8f0" },
      "popoverForeground": { "$value": "#192f40" },
      "muted": { "$value": "#eddfd1" },
      "mutedForeground": { "$value": "#52636e", "$description": "Contrast adaptation of source #586b76 for text on the darker paper2 surface." },
      "destructive": { "$value": "#b43c29", "$description": "Derived danger role, distinct from editorial accent." },
      "destructiveForeground": { "$value": "#fff5e9" },
      "input": { "$value": "#586b76", "$description": "Derived stronger boundary for interactive controls." },
      "ring": { "$value": "#245c70" },
      "chart1": { "$value": "#245c70" },
      "chart2": { "$value": "#c74935" },
      "chart3": { "$value": "#63744b" },
      "chart4": { "$value": "#a77b30" },
      "chart5": { "$value": "#805a79" },
      "sidebar": { "$value": "#eddfd1" },
      "sidebarForeground": { "$value": "#192f40" },
      "sidebarBorder": { "$value": "#d8c8b8" },
      "sidebarPrimary": { "$value": "#245c70" },
      "sidebarPrimaryForeground": { "$value": "#fff5e9" },
      "sidebarAccent": { "$value": "#f7eee4" },
      "sidebarAccentForeground": { "$value": "#192f40" },
      "sidebarRing": { "$value": "#245c70" }
    },
    "dark": {
      "primary": { "$value": "#9bc8d5" },
      "primaryForeground": { "$value": "#132734" },
      "secondary": { "$value": "#314c59" },
      "secondaryForeground": { "$value": "#f7eee4" },
      "accent": { "$value": "#e78d73" },
      "accentForeground": { "$value": "#132734" },
      "background": { "$value": "#132734" },
      "foreground": { "$value": "#f7eee4" },
      "border": { "$value": "#49616b" },
      "card": { "$value": "#192f40" },
      "cardForeground": { "$value": "#f7eee4" },
      "popover": { "$value": "#192f40" },
      "popoverForeground": { "$value": "#f7eee4" },
      "muted": { "$value": "#213d4c" },
      "mutedForeground": { "$value": "#b9c5c9" },
      "destructive": { "$value": "#ef9b89" },
      "destructiveForeground": { "$value": "#132734" },
      "input": { "$value": "#91a9b2" },
      "ring": { "$value": "#9bc8d5" },
      "chart1": { "$value": "#9bc8d5" },
      "chart2": { "$value": "#e78d73" },
      "chart3": { "$value": "#aabb87" },
      "chart4": { "$value": "#d9b776" },
      "chart5": { "$value": "#c7a4c1" },
      "sidebar": { "$value": "#192f40" },
      "sidebarForeground": { "$value": "#f7eee4" },
      "sidebarBorder": { "$value": "#49616b" },
      "sidebarPrimary": { "$value": "#9bc8d5" },
      "sidebarPrimaryForeground": { "$value": "#132734" },
      "sidebarAccent": { "$value": "#314c59" },
      "sidebarAccentForeground": { "$value": "#f7eee4" },
      "sidebarRing": { "$value": "#9bc8d5" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "Noto Sans Arabic", "sans-serif"],
        "$description": "DM Sans for Latin UI/body text; Noto Sans Arabic for Arabic glyphs."
      },
      "serif": { "$value": ["Fraunces", "Noto Sans Arabic", "Georgia", "serif"] },
      "mono": { "$value": ["IBM Plex Mono", "Noto Sans Arabic", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.1875rem",
      "$description": "Source 3px action corner. Alternate action corners multiply this by 14/3; pill controls use the capsule shape."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
