# Copy these names into Replit Secrets (Tools -> Secrets). Never commit real values.

# Required
DATABASE_URL=
SESSION_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Email of the first coordinator account (grants initial admin access)
JUSOOR_BOOTSTRAP_COORDINATOR_EMAIL=

# Optional: extra browser origins allowed to call the API with login cookies,
# comma-separated full origins, e.g. a custom domain. This deployment's own
# Replit domains are allowed automatically.
CORS_ALLOWED_ORIGINS=

# Integrations (only needed for the features you use)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
PRIVATE_OBJECT_DIR=
